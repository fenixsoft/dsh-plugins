{
  "name": "fenix-dsh-settings-dock",
  "version": "0.3.0",
  "description": "dsh web 设置停靠：官方设置弹窗（固定 800×800 居中）页面化停靠到侧栏右侧内容区——无遮罩、侧栏保持可点、Esc/关闭按钮退出；窄屏维持官方弹窗形态。rc.5 起独立「插件」「自动化任务」页同缝铺满（解除官方 960px 居中列宽）",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.0 <0.3"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
